{
    "name": "@sealgate/mcp",
    "version": "0.1.0",
    "mcpName": "io.github.edison-watch/sealgate-mcp",
    "description": "Sealgate MCP server: a thin MCP proxy to your organisation's Sealgate AI security gateway and data firewall.",
    "type": "module",
    "bin": {
        "sealgate": "./dist/index.js"
    },
    "files": ["dist", "README.md", "LICENSE"],
    "homepage": "https://sealgate.ai",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Edison-Watch/sealgate-mcp.git"
    },
    "bugs": {
        "url": "https://github.com/Edison-Watch/sealgate-mcp/issues"
    },
    "license": "MIT",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "sealgate",
        "ai-security",
        "data-loss-prevention",
        "mcp-gateway",
        "mcp-server",
        "ai-agents"
    ],
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "start": "bun run src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target node --minify",
        "fmt": "biome check --write",
        "lint": "biome check",
        "deadcode": "knip",
        "typecheck": "tsc --noEmit",
        "lint:links": "find . -name '*.md' -not -path './node_modules/*' | xargs markdown-link-check --quiet --config .markdown-link-check.json",
        "ci": "bun run lint && bun run deadcode && bun run typecheck && bun run lint:links",
        "test": "bun test",
        "test:fast": "bun test --timeout 5000",
        "test:watch": "bun test --watch"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.0",
        "@types/bun": "^1.3.9",
        "dependency-cruiser": "^17.3.8",
        "jscpd": "^4.0.8",
        "knip": "^5.0.0",
        "markdown-link-check": "^3.12.0",
        "typescript": "^5.7.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "yaml": "^2.8.2",
        "zod": "^4.3.6"
    }
}
